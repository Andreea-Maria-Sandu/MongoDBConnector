{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "name",
      "email",
      "password"
    ],
    "properties": {
      "_id": {},
      "name": {
        "bsonType": "string",
        "minLength": 1
      },
      "email": {
        "bsonType": "string",
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
      },
      "password": {
        "bsonType": "string",
        "pattern": "^\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}$"
      }
    },
    "additionalProperties": true
  }
}